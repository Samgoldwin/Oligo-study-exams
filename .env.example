# Copy to .env.local and fill in. Never commit .env.local.

# Required for AI answers (server-side only, used by /api/* functions)
GROQ_API_KEY=

# Optional: override the default chat model (openai/gpt-oss-120b)
# SYNCAI_MODEL=openai/gpt-oss-120b

# Optional: YouTube Data API v3 key (server-side only).
# Without it, video search degrades gracefully and everything else keeps working.
YOUTUBE_API_KEY=

# Optional: local dev API port (default 8787)
# DEV_API_PORT=8787
