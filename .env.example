# ──────────────────────────────────────────────────────────────
# SyncAI — environment variables (copy to .env.local; never commit)
# ──────────────────────────────────────────────────────────────

# Groq (default AI provider) — server-side only
GROQ_API_KEY=
# Optional: override default chat model (default openai/gpt-oss-120b)
# SYNCAI_MODEL=openai/gpt-oss-120b

# YouTube Data API v3 (server-side only)
YOUTUBE_API_KEY=

# ── Firebase Authentication + Firestore (BYO models + history) ──
# Web SDK config (public-safe) — from Firebase console → Project settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=syncai-16e34.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=syncai-16e34

# Backend service account JSON (for validating ID tokens + Firestore).
# Paste the ENTIRE service account JSON as a single line, e.g.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT=

# ── BYO model key encryption (RSA-2048) ──
# Generate once:  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#                   -out private.pem (PKCS8)
#                 openssl pkey -in private.pem -pubout -out public.pem
# The public key is served via GET /api/syncai/pubkey; the private key
# decrypts user API keys in-memory at request time.
PUBLIC_RSA_KEY=
PRIVATE_RSA_KEY=

# Local dev API port (default 8787)
# DEV_API_PORT=8787
